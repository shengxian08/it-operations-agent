COMPOSE_PROJECT_NAME=itops-production
ITOPS_API_IMAGE=ghcr.io/your-organization/itops-api
ITOPS_WEB_IMAGE=ghcr.io/your-organization/itops-web
ITOPS_WORKER_IMAGE=ghcr.io/your-organization/itops-worker
IMAGE_TAG=replace-with-verified-commit-sha
ALERTMANAGER_CONFIG=./infra/monitoring/alertmanager.example.yml
SECRET_DIR=./secrets
PUBLIC_BASE_URL=https://itops.example.com
OIDC_ISSUER=https://itops.example.com/identity/realms/itops
OPENAI_BASE_URL=https://approved-model.example/v1
OPENAI_MODEL=approved-model-name
# Same currency for monthly budget and prices; both prices are per one million tokens.
MODEL_MONTHLY_BUDGET=0
MODEL_INPUT_PRICE=0
MODEL_OUTPUT_PRICE=0
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
EMBEDDING_DIMENSIONS=512
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
