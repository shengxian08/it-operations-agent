{
  "realm": "itops",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "employee"
      },
      {
        "name": "support"
      },
      {
        "name": "admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "itops-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "e2e-client-secret-not-for-production",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:18517/api/v1/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:18517"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:18517"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "itops-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "e2e-employee",
      "email": "e2e-employee@example.test",
      "emailVerified": true,
      "lastName": "employee",
      "username": "e2e-employee",
      "realmRoles": [
        "employee"
      ],
      "enabled": true,
      "firstName": "E2E",
      "credentials": [
        {
          "temporary": false,
          "value": "E2e-only-employee-123",
          "type": "password"
        }
      ]
    },
    {
      "id": "e2e-support",
      "email": "e2e-support@example.test",
      "emailVerified": true,
      "lastName": "support",
      "username": "e2e-support",
      "realmRoles": [
        "support"
      ],
      "enabled": true,
      "firstName": "E2E",
      "credentials": [
        {
          "temporary": false,
          "value": "E2e-only-support-123",
          "type": "password"
        }
      ]
    },
    {
      "id": "e2e-admin",
      "email": "e2e-admin@example.test",
      "emailVerified": true,
      "lastName": "admin",
      "username": "e2e-admin",
      "realmRoles": [
        "admin"
      ],
      "enabled": true,
      "firstName": "E2E",
      "credentials": [
        {
          "temporary": false,
          "value": "E2e-only-admin-123",
          "type": "password"
        }
      ]
    }
  ]
}
